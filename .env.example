# Application
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scheduling_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# CORS
CORS_ORIGIN=http://localhost:3001

# JWT (for future authentication)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d